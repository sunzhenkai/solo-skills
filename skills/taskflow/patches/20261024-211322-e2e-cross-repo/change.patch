+# ---------------------------------------------------------------------------
+# 夹具：direct 模式（异步报表 CSV 跨仓下载，父任务 + 两个子任务）
+# ---------------------------------------------------------------------------
+
+DIRECT_API_FILES = {
+    ".gitignore": GITIGNORE,
+    "pyproject.toml": (
+        "[project]\n"
+        'name = "acceptance-api"\n'
+        'version = "0.1.0"\n'
+        'description = "异步报表任务 API 验收仓"\n'
+        'requires-python = ">=3.9"\n'
+    ),
+    "api/__init__.py": (
+        '"""异步报表 API 验收包。"""\n\n'
+        "from .exporter import AsyncReportJobStore, JobNotFoundError, JobNotReadyError, JobStatus\n\n"
+        "__all__ = [\n"
+        '    "AsyncReportJobStore",\n'
+        '    "JobNotFoundError",\n'
+        '    "JobNotReadyError",\n'
+        '    "JobStatus",\n'
+        "]\n"
+    ),
+    "api/exporter.py": '''"""异步报表任务 API。"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass
+from typing import Iterable, Mapping
+
+
+class JobNotFoundError(KeyError):
+    """任务不存在。"""
+
+
+class JobNotReadyError(RuntimeError):
+    """任务未完成，暂不能读取结果。"""
+
+
+@dataclass(frozen=True)
+class JobStatus:
+    job_id: str
+    state: str
+    rows: int
+
+
+class AsyncReportJobStore:
+    """内存版异步任务仓库；外部只依赖公开方法。"""
+
+    def __init__(self) -> None:
+        self._pending: dict[str, list[dict[str, str]]] = {}
+        self._completed: dict[str, list[dict[str, str]]] = {}
+        self._sequence = 0
+
+    def submit(self, rows: Iterable[Mapping[str, str]]) -> str:
+        materialized = [dict(row) for row in rows]
+        if not materialized:
+            raise ValueError("rows 不能为空")
+        self._sequence += 1
+        job_id = f"job-{self._sequence:04d}"
+        self._pending[job_id] = materialized
+        return job_id
+
+    def finish_next(self) -> JobStatus:
+        if not self._pending:
+            raise LookupError("没有待完成任务")
+        job_id = next(iter(self._pending))
+        rows = self._pending.pop(job_id)
+        self._completed[job_id] = rows
+        return JobStatus(job_id=job_id, state="completed", rows=len(rows))
+
+    def status(self, job_id: str) -> JobStatus:
+        if job_id in self._pending:
+            return JobStatus(job_id=job_id, state="pending", rows=len(self._pending[job_id]))
+        if job_id in self._completed:
+            return JobStatus(job_id=job_id, state="completed", rows=len(self._completed[job_id]))
+        raise JobNotFoundError(job_id)
+
+    def result(self, job_id: str) -> bytes:
+        if job_id in self._pending:
+            raise JobNotReadyError(job_id)
+        if job_id not in self._completed:
+            raise JobNotFoundError(job_id)
+        rows = self._completed[job_id]
+        fieldnames = list(dict.fromkeys(key for row in rows for key in row))
+        output = io.StringIO(newline="")
+        writer = csv.DictWriter(output, fieldnames=fieldnames, lineterminator="\\n")
+        writer.writeheader()
+        writer.writerows(rows)
+        return output.getvalue().encode("utf-8")
+''',
+    "tests/__init__.py": '"""API 验收测试。"""\n',
+    "tests/test_exporter.py": '''import unittest
