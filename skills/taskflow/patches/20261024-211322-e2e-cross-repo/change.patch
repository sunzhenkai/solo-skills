+OPENSPEC_INTEGRATION = '''"""End-to-end cross-repo integration check for task openspec-cross-repo.
+
+Uses the real API worktree (SnapshotStore) and the real Web worktree
+(export_snapshot) together:
+  1. register items -> snapshot not ready -> export must fail explicitly
+  2. mark_ready -> export to catalog.tsv -> content must match snapshot
+  3. no *.tmp file left behind
+"""
+
+from __future__ import annotations
+
+import pathlib
+import sys
+import tempfile
+
+
+def find_workspace(start: pathlib.Path) -> pathlib.Path:
+    """Walk upward until a dir contains both expected worktrees."""
+    for candidate in [start, *start.parents]:
+        wt = candidate / "worktrees" / "openspec-cross-repo"
+        if (wt / "catalog-api").is_dir() and (wt / "catalog-web").is_dir():
+            return candidate
+    raise SystemExit("FAIL: workspace with both worktrees not found")
+
+
+def main() -> int:
+    workspace = find_workspace(pathlib.Path(__file__).resolve())
+    worktrees = workspace / "worktrees" / "openspec-cross-repo"
+    sys.path.insert(0, str(worktrees / "catalog-api"))
+    sys.path.insert(0, str(worktrees / "catalog-web"))
+
+    from catalog.snapshots import SnapshotStore  # noqa: E402
+    from catalog_export.exporter import (  # noqa: E402
+        SnapshotExportNotReadyError,
+        export_snapshot,
+    )
+
+    store = SnapshotStore()
+    snapshot_id = store.register([{"sku": "A-1", "count": "3"}, {"sku": "B-2", "count": "5"}])
+
+    with tempfile.TemporaryDirectory() as tmpdir:
+        dest = pathlib.Path(tmpdir) / "integration-output" / "catalog.tsv"
+
+        try:
+            export_snapshot(store, snapshot_id, dest)
+        except SnapshotExportNotReadyError:
+            print("PASS: export rejected before snapshot ready")
+        else:
+            print("FAIL: export succeeded before snapshot ready")
+            return 1
+        assert not dest.exists(), "FAIL: destination written before ready"
+
+        store.mark_ready(snapshot_id)
+        result = export_snapshot(store, snapshot_id, dest)
+        expected = "sku\\tcount\\nA-1\\t3\\nB-2\\t5\\n".encode("utf-8")
+        actual = result.read_bytes()
+        if actual != expected:
+            print(f"FAIL: content mismatch\\n  expected: {expected!r}\\n  actual:   {actual!r}")
+            return 1
+        print("PASS: exported TSV matches inventory snapshot")
+
+        tmp_leftover = [p.name for p in result.parent.iterdir() if p.name.endswith(".tmp")]
+        if tmp_leftover:
+            print(f"FAIL: temp files left: {tmp_leftover}")
+            return 1
+        print("PASS: no .tmp file left after export")
+
+        artifact = pathlib.Path(__file__).resolve().parent / "integration-output" / "catalog.tsv"
+        artifact.parent.mkdir(parents=True, exist_ok=True)
+        artifact.write_bytes(actual)
+        print(f"PASS: artifact written to {artifact}")
+
+    print("INTEGRATION PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+'''
