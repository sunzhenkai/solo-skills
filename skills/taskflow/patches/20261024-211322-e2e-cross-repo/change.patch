+#!/usr/bin/env python3
+"""跨仓 E2E 回归：taskrail / taskflow 的 direct 与 OpenSpec CLI 双模式。
+
+一键在临时目录创建两个 git 夹具仓，复现两条已验收的跨仓路径并逐步断言：
+
+  direct    taskrail 父任务 + 两个子任务 + git worktree + 父级集成
+            （只依赖 git 与 python3，不需要 openspec CLI）
+  openspec  handoff 门 -> driver -> 两个子 change -> strict validate
+            -> CLI archive -> 父级集成（额外需要 openspec CLI）
+
+用法：
+  python3 scripts/e2e_cross_repo.py [--mode all|direct|openspec]
+                                    [--root DIR] [--keep]
+                                    [--report PATH] [--openspec-bin PATH]
+
+退出码：0 全部通过；1 存在失败；2 用法 / 环境错误。
+报告默认写到当前目录 ./e2e-cross-repo-report-<timestamp>.md。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import platform
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from datetime import datetime
+from pathlib import Path
+from string import Template
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+SKILL_SCRIPTS = REPO_ROOT / "skills"
+TASK_STATE = SKILL_SCRIPTS / "taskrail" / "scripts" / "task_state.py"
+CHECK_HANDOFF = SKILL_SCRIPTS / "taskflow" / "scripts" / "check_handoff.py"
+PREPARE_WORKTREE = SKILL_SCRIPTS / "taskflow" / "scripts" / "prepare_worktree.py"
+
+GITIGNORE = "__pycache__/\n*.py[cod]\n"
+
+
+class E2eError(Exception):
+    """单个步骤失败；消息直接进入报告。"""
+
+
+class Step:
+    def __init__(self, mode: str, name: str, ok: bool, detail: str = "") -> None:
+        self.mode = mode
+        self.name = name
+        self.ok = ok
+        self.detail = detail
+
+
+class Reporter:
+    def __init__(self) -> None:
+        self.steps: list[Step] = []
+        self.env: dict[str, str] = {}
+
+    def record(self, mode: str, name: str, ok: bool, detail: str = "") -> None:
+        mark = "PASS" if ok else "FAIL"
+        self.steps.append(Step(mode, name, ok, detail))
+        suffix = f"  -- {detail}" if detail else ""
+        print(f"[{mark}] {mode}: {name}{suffix}", flush=True)
+        if not ok:
+            raise E2eError(f"{mode}: {name}: {detail}")
+
+    def render(self, root: Path | None, kept: bool) -> str:
+        lines = [
+            "# 跨仓 E2E 回归报告",
+            "",
+            f"- 时间：{datetime.now().isoformat(timespec='seconds')}",
+            f"- Python：{platform.python_version()}",
+            f"- git：{self.env.get('git', 'unknown')}",
+            f"- openspec CLI：{self.env.get('openspec', '未使用 / 未安装')}",
+            f"- 脚本：`scripts/e2e_cross_repo.py`（repo root：{REPO_ROOT}）",
+            f"- 临时根目录：{root if kept else '（已清理）'}",
+            "",
+            "## 步骤明细",
+            "",
+            "| 模式 | 步骤 | 结果 | 说明 |",
+            "|---|---|---|---|",
+        ]
+        for step in self.steps:
+            mark = "PASS" if step.ok else "FAIL"
+            detail = step.detail.replace("|", "\\|")
+            lines.append(f"| {step.mode} | {step.name} | {mark} | {detail} |")
+        failures = [s for s in self.steps if not s.ok]
+        lines += ["", "## 结论", ""]
+        lines.append("全部通过。" if not failures else f"{len(failures)} 个步骤失败，见上表。")
+        return "\n".join(lines) + "\n"
+
+
+def base_env() -> dict[str, str]:
+    env = dict(os.environ)
+    env.setdefault("GIT_AUTHOR_NAME", "e2e")
+    env.setdefault("GIT_AUTHOR_EMAIL", "e2e@example.invalid")
+    env.setdefault("GIT_COMMITTER_NAME", "e2e")
+    env.setdefault("GIT_COMMITTER_EMAIL", "e2e@example.invalid")
+    return env
+
+
+def run(cmd: list[str], cwd: Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
+    proc = subprocess.run(
+        cmd,
+        cwd=str(cwd) if cwd else None,
+        env=env or base_env(),
+        capture_output=True,
+        text=True,
+    )
+    if proc.returncode != 0:
+        tail = "\n".join((proc.stdout + proc.stderr).splitlines()[-15:])
+        raise E2eError(f"命令失败（exit {proc.returncode}）：{' '.join(cmd)}\n{tail}")
+    return proc
+
+
+def run_json(cmd: list[str], cwd: Path) -> dict:
+    proc = run(cmd, cwd=cwd)
+    try:
+        return json.loads(proc.stdout)
+    except json.JSONDecodeError as exc:
+        raise E2eError(f"JSON 解析失败：{' '.join(cmd)}\n{proc.stdout[:500]}") from exc
+
+
+def git(repo: Path, *args: str) -> str:
+    return run(["git", "-C", str(repo), *args]).stdout.strip()
+
+
+def write_tree(root: Path, files: dict[str, str]) -> None:
+    for rel, content in files.items():
+        target = root / rel
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(content, encoding="utf-8")
+
+
+def init_source_repo(root: Path, name: str, readme: str) -> Path:
+    repo = root / "sources" / name
+    repo.mkdir(parents=True)
+    write_tree(repo, {"README.md": readme})
+    git(repo, "init", "-q", "-b", "main")
+    git(repo, "add", "-A")
+    git(repo, "commit", "-q", "-m", f"Prepare {name} acceptance baseline")
+    return repo
+
+
+def set_section(text: str, title: str, content: str) -> str:
+    section = f"## {title}\n{content.rstrip()}\n\n"
+    pattern = rf"^## {re.escape(title)}\n.*?(?=^## |\Z)"
+    updated, count = re.subn(pattern, section.rstrip() + "\n\n", text, flags=re.S | re.M)
+    return updated if count else text.rstrip() + "\n\n" + section
+
+
+def tick_plan(path: Path) -> None:
+    text = path.read_text(encoding="utf-8")
+    text = text.replace("- [ ]", "- [x]")
+    path.write_text(text, encoding="utf-8")
+
+
+def parse_test_count(output: str) -> int:
+    match = re.search(r"Ran (\d+) tests?", output)
+    if not match:
+        raise E2eError(f"无法从测试输出解析用例数：\n{output[-300:]}")
+    if "OK" not in output:
+        raise E2eError(f"测试未全部通过：\n{output[-500:]}")
+    return int(match.group(1))
+
+
+def run_unit_tests(worktree: Path, evidence_rel: str, write_evidence: bool = True) -> int:
+    # unittest -v 把结果写到 stderr；证据文件合并两个流。
+    # 复跑（driver 收尾 3.1）不覆盖已提交的证据：计时行每次不同，会弄脏 worktree。
+    proc = run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"], cwd=worktree)
+    output = proc.stdout + proc.stderr
+    count = parse_test_count(output)
+    if write_evidence:
+        evidence = worktree / evidence_rel
+        evidence.parent.mkdir(parents=True, exist_ok=True)
+        evidence.write_text(output, encoding="utf-8")
+    return count
+
+
+def commit_all(worktree: Path, message: str) -> str:
+    git(worktree, "add", "-A")
+    git(worktree, "commit", "-q", "-m", message)
+    return git(worktree, "rev-parse", "--short", "HEAD")
+
