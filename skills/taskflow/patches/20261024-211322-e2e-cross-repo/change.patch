+    "catalog/snapshots.py": '''"""库存快照状态机。"""
+
+from __future__ import annotations
+
+from typing import Iterable, Mapping
+
+
+class SnapshotValidationError(ValueError):
+    """快照输入无效。"""
+
+
+class SnapshotNotFoundError(KeyError):
+    """快照不存在。"""
+
+
+class SnapshotNotReadyError(RuntimeError):
+    """快照尚未 ready。"""
+
+
+class SnapshotStore:
+    """内存库存快照仓库。"""
+
+    def __init__(self) -> None:
+        self._snapshots: dict[str, dict[str, object]] = {}
+        self._sequence = 0
+
+    def register(self, items: Iterable[Mapping[str, str]]) -> str:
+        materialized = [dict(item) for item in items]
+        if not materialized:
+            raise SnapshotValidationError("库存项不能为空")
+        self._sequence += 1
+        snapshot_id = f"snap-{self._sequence:04d}"
+        self._snapshots[snapshot_id] = {"items": materialized, "ready": False}
+        return snapshot_id
+
+    def mark_ready(self, snapshot_id: str) -> None:
+        snapshot = self._snapshots.get(snapshot_id)
+        if snapshot is None:
+            raise SnapshotNotFoundError(snapshot_id)
+        snapshot["ready"] = True
+
+    def is_ready(self, snapshot_id: str) -> bool:
+        snapshot = self._snapshots.get(snapshot_id)
+        if snapshot is None:
+            raise SnapshotNotFoundError(snapshot_id)
+        return bool(snapshot["ready"])
+
+    def snapshot_items(self, snapshot_id: str) -> list[dict[str, str]]:
+        snapshot = self._snapshots.get(snapshot_id)
+        if snapshot is None:
+            raise SnapshotNotFoundError(snapshot_id)
+        if not snapshot["ready"]:
+            raise SnapshotNotReadyError(snapshot_id)
+        items = snapshot["items"]
+        return [dict(item) for item in items]  # type: ignore[union-attr]
+''',
