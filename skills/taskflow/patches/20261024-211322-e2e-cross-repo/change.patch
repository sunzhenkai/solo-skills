+    "catalog_export/exporter.py": '''"""Export a ready inventory snapshot to a stable UTF-8 TSV file."""
+
+from __future__ import annotations
+
+import pathlib
+
+
+class SnapshotExportNotReadyError(RuntimeError):
+    """Raised when exporting a snapshot that is not ready."""
+
+
+def export_snapshot(api, snapshot_id: str, destination) -> pathlib.Path:
+    """Export a ready snapshot to ``destination`` as UTF-8 TSV.
+
+    ``api`` only needs ``is_ready(snapshot_id) -> bool`` and
+    ``snapshot_items(snapshot_id) -> list[dict[str, str]]``.
+    The file is written atomically: a sibling ``*.tmp`` file is created
+    first, then moved over the destination, leaving no temp file behind.
+    """
+    if not api.is_ready(snapshot_id):
+        raise SnapshotExportNotReadyError(snapshot_id)
+
+    items = api.snapshot_items(snapshot_id)
+
+    lines = ["sku\\tcount"]
+    for item in items:
+        lines.append(f"{item['sku']}\\t{item['count']}")
+    payload = ("\\n".join(lines) + "\\n").encode("utf-8")
+
+    path = pathlib.Path(destination)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + ".tmp")
+    tmp.write_bytes(payload)
+    tmp.replace(path)
+    return path
+''',
