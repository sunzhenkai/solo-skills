+    evidence = task_archive / "evidence"
+    evidence.mkdir(parents=True, exist_ok=True)
+    (evidence / "openspec_integration_check.py").write_text(OPENSPEC_INTEGRATION, encoding="utf-8")
+    proc = run([sys.executable, str(evidence / "openspec_integration_check.py")], cwd=task_archive)
+    if "INTEGRATION PASS" not in proc.stdout:
+        raise E2eError(f"集成脚本未 PASS：\n{proc.stdout}")
+    (evidence / "openspec-integration-tests.txt").write_text(proc.stdout, encoding="utf-8")
+    rep.record(mode, "父级跨仓集成（driver 收尾前）", True, "INTEGRATION PASS")
+
+    ctx_values["api_commit"] = api_commit
+    ctx_values["web_commit"] = web_commit
+    (driver_dir / "proposal.md").write_text(driver_proposal(ctx_values, filled=True), encoding="utf-8")
+    driver_tasks = driver_dir / "tasks.md"
+    driver_tasks.write_text(driver_tasks.read_text(encoding="utf-8").replace("- [ ]", "- [x]"),
+                            encoding="utf-8")
+    valid = run_json([openspec_bin, "validate", f"{task_id}-driver", "--strict", "--json"], cwd=ws)
+    rep.record(mode, "driver validate --strict", bool(valid["items"][0]["valid"]),
+               f"issues={len(valid['items'][0]['issues'])} 条（skip_specs 提示）")
+    archived = run_json([openspec_bin, "archive", f"{task_id}-driver", "--yes", "--json"], cwd=ws)
+    rep.record(mode, "driver archive", archived["archive"]["archivedAs"] == f"{today}-{task_id}-driver",
+               archived["archive"]["archivedAs"])
+
+    for spec_name in ("inventory-snapshots", "inventory-snapshot-export"):
+        if not (ws / "openspec" / "specs" / spec_name / "spec.md").is_file():
+            raise E2eError(f"主 spec 未生成：{spec_name}")
+    rep.record(mode, "主 specs 已更新", True, "inventory-snapshots + inventory-snapshot-export")
+
+    (task_archive / "SUMMARY.md").write_text(
+        "# SUMMARY：实现跨仓库存快照导出\n\n"
+        "## 结果\n"
+        f"完成判据达成。API commit `{api_commit}`（5 项测试），Web commit `{web_commit}`（4 项测试）；"
+        "driver 与两个子 change 均已 CLI 归档。\n\n"
+        "## 剩余风险\n- 临时本地验收仓，分支未 push、未合入 main。\n",
+        encoding="utf-8")
+    tick_plan(task_archive / "PLAN.md")
+    run([sys.executable, str(TASK_STATE), "update", str(ws), task_id,
+         "--current-ref", "verify"])
+    run([sys.executable, str(TASK_STATE), "update", str(ws), task_id,
+         "--current-ref", "close", "--status", "done", "--next", "任务完成，等待同轮归档"])
+    rep.record(mode, "父任务 close 门禁", True, "SUMMARY + 无未完成子任务")
+
+    archive_target = ws / "tasks" / "archive" / today / task_id
+    archive_target.parent.mkdir(parents=True, exist_ok=True)
+    task_archive.rename(archive_target)
+    run([sys.executable, str(TASK_STATE), "rebuild-index", str(ws)])
+    index = (ws / "tasks" / "INDEX.md").read_text(encoding="utf-8")
+    rep.record(mode, "归档 + rebuild-index", "archive/" in index and "done" in index,
+               f"tasks/archive/{today}/{task_id}")
+
+    proc = run([sys.executable, str(archive_target / "evidence" / "openspec_integration_check.py")],
+               cwd=archive_target)
+    rep.record(mode, "归档位置复跑集成", "INTEGRATION PASS" in proc.stdout, "向上查找 workspace 生效")
+
+    for src in (api_src, web_src):
+        if git(src, "status", "--porcelain"):
+            raise E2eError(f"源仓 main 被修改：{src}")
+    for wt in (api_wt, web_wt):
+        if git(wt, "status", "--porcelain"):
+            raise E2eError(f"worktree 不干净：{wt}")
+    rep.record(mode, "源仓与 worktree 终态干净", True,
+               f"api={api_commit} web={web_commit}")
+    rep.record(mode, "openspec 模式完成", True, f"耗时 {time.monotonic() - started:.1f}s")
+
+
+# ---------------------------------------------------------------------------
+# 入口
+# ---------------------------------------------------------------------------
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--mode", choices=("all", "direct", "openspec"), default="all")
+    parser.add_argument("--root", help="复用已有目录而非新建临时目录（调试用）")
+    parser.add_argument("--keep", action="store_true", help="保留临时目录与产物")
+    parser.add_argument("--report", help="报告输出路径（默认当前目录）")
+    parser.add_argument("--openspec-bin", help="openspec CLI 路径（默认从 PATH 查找）")
+    args = parser.parse_args(argv)
+
+    if not shutil.which("git"):
+        print("FAIL: 未找到 git", file=sys.stderr)
+        return 2
+    for script in (TASK_STATE, CHECK_HANDOFF, PREPARE_WORKTREE):
+        if not script.is_file():
+            print(f"FAIL: skill 脚本缺失：{script}", file=sys.stderr)
+            return 2
+
+    rep = Reporter()
+    rep.env["git"] = run(["git", "--version"]).stdout.strip()
+
+    openspec_bin = args.openspec_bin or shutil.which("openspec")
+    modes = ("direct", "openspec") if args.mode == "all" else (args.mode,)
+    if "openspec" in modes and not openspec_bin:
+        print("FAIL: openspec CLI 未安装（--mode 包含 openspec）", file=sys.stderr)
+        return 2
+
+    root = Path(args.root) if args.root else Path(tempfile.mkdtemp(prefix="taskrail-e2e-"))
+    root.mkdir(parents=True, exist_ok=True)
+    exit_code = 0
+    try:
+        if "direct" in modes:
+            run_direct(root, rep)
+        if "openspec" in modes:
+            run_openspec(root, rep, openspec_bin)
+    except E2eError as exc:
+        rep.steps.append(Step("e2e", "未捕获步骤", False, str(exc).replace("\n", " / ")))
+        print(f"[FAIL] e2e: 未捕获步骤 -- {exc}", flush=True)
+        exit_code = 1
+
+    report_path = Path(args.report) if args.report else (
+        Path.cwd() / f"e2e-cross-repo-report-{datetime.now().strftime('%Y%m%d-%H%M%S')}.md")
+    report_path.write_text(rep.render(root if args.keep else None, bool(args.keep)), encoding="utf-8")
+    print(f"报告：{report_path}")
+    if not args.keep and not args.root:
+        shutil.rmtree(root, ignore_errors=True)
+    failures = [s for s in rep.steps if not s.ok]
+    if failures:
+        print(f"FAIL: {len(failures)} 个步骤失败", file=sys.stderr)
+        return 1 if exit_code == 0 else exit_code
+    print("E2E PASS")
+    return exit_code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
