+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+
+class ReportNotReadyError(RuntimeError):
+    """报表任务未完成。"""
+
+
+def download_report(store: Any, job_id: str, destination: str | Path) -> Path:
+    status = store.status(job_id)
+    if getattr(status, "state", None) != "completed":
+        raise ReportNotReadyError(f"报表任务 {job_id} 尚未完成")
+
+    data = store.result(job_id)
+    path = Path(destination)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f"{path.name}.tmp")
+    temporary.write_bytes(data)
+    temporary.replace(path)
+    return path
+''',
