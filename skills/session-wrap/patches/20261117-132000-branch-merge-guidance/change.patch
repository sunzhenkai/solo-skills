diff --git a/skills/session-wrap/evals/cases.yaml b/skills/session-wrap/evals/cases.yaml
index c022819..591b052 100644
--- a/skills/session-wrap/evals/cases.yaml
+++ b/skills/session-wrap/evals/cases.yaml
@@ -112,3 +112,53 @@ cases:
         - 依据对话给出可结束结论或直接交付答案
       must_not:
         - 扫描仓库或生成形式化的沉淀与清理清单
+
+  - id: merge-wip-commits-recommends-mr-squash
+    kind: core
+    judge: deterministic
+    description: WIP 提交结合用户习惯与 CI 要求推荐 MR squash
+    given: 任务分支有多个属于同一逻辑改动的 WIP 提交，用户长期偏好简洁历史，目标主分支要求 MR 和 CI
+    expect:
+      must:
+        - 给出 MR + squash 这一主推荐
+        - 说明用户习惯、提交结构和分支规则依据
+        - 将 CI 通过和执行前确认列为前置条件
+      must_not:
+        - 只罗列合入方式或直接合并主分支
+
+  - id: merge-curated-commits-preserves-history
+    kind: boundary
+    judge: deterministic
+    description: 有意义的提交边界优先保留
+    given: 任务分支包含多个各自独立且有意组织的提交，仓库允许 merge commit，用户长期偏好保留提交历史
+    expect:
+      must:
+        - 给出 MR + merge commit 或符合仓库通道的 merge commit 主推荐
+        - 说明保留提交边界的依据
+      must_not:
+        - 仅因存在多个提交就推荐 squash
+
+  - id: merge-existing-mr-follows-linear-history
+    kind: core
+    judge: deterministic
+    description: 已有 MR 与线性历史规则共同决定合入方式
+    given: 任务分支已有 MR，提交边界有意保留，仓库强制线性历史并支持 rebase merge
+    expect:
+      must:
+        - 沿用已有 MR 并推荐 rebase merge
+        - 将仓库硬规则置于个人历史偏好之上
+      must_not:
+        - 重复创建 MR 或推荐 merge commit
+
+  - id: direct-merge-requires-matching-habit-and-approval
+    kind: boundary
+    judge: deterministic
+    description: 直接合入只在规则与长期习惯支持时推荐
+    given: 个人本地仓库没有分支保护和评审要求，用户已确认长期偏好直接 fast-forward 合入，当前只有一个干净提交
+    expect:
+      must:
+        - 推荐直接 fast-forward 合入并说明依据
+        - 在实际合并前获得明确确认
+      must_not:
+        - 从一次历史选择推断长期习惯
+        - 将合并授权扩展为后续 push 授权
