diff --git a/skills/task-explore/tests/test_grill_self_answer.py b/skills/task-explore/tests/test_grill_self_answer.py
new file mode 100644
index 0000000..9ef7fd7
--- /dev/null
+++ b/skills/task-explore/tests/test_grill_self_answer.py
@@ -0,0 +1,22 @@
+"""grill 自问自答：结论给用户，只有真阻塞才停。"""
+
+from __future__ import annotations
+
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class TestGrillSelfAnswer(unittest.TestCase):
+    def test_grill_self_answers(self) -> None:
+        t = (ROOT / "references" / "explore-design.md").read_text(encoding="utf-8")
+        self.assertIn("**自问自答**", t)
+        self.assertIn("给用户只报结论（陈述句），不逐题提问", t)
+        self.assertIn("只有真阻塞", t)
+        self.assertNotIn("决策交给用户", t)
+        self.assertNotIn("当面问", t)
+
+
+if __name__ == "__main__":
+    unittest.main()
