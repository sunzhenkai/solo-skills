+"""task* 族跨 skill 契约：载荷归属单一、族级规则引用真源、相对链接可达。
+
+放在 task-goal/tests 下是因为 CI 只跑 `pytest skills`（见 .github/workflows/ci.yml），
+且仓内已有跨目录读 sibling skill 的先例（test_task_goal_contract.py 对 task-wizard 的断言）。
+"""
+
+from __future__ import annotations
+
+import re
+import unittest
+from pathlib import Path
+
+SKILLS_ROOT = Path(__file__).resolve().parents[2]
+TASK_SKILLS = ("task-wizard", "task-goal", "task-explore", "taskflow", "task-delivery")
+SKIP_DIRS = {"patches", "evolutions", "experience", "tests", "evals", "examples"}
+
+
+def read(skill: str, rel: str) -> str:
+    return (SKILLS_ROOT / skill / rel).read_text(encoding="utf-8")
+
+
+def live_texts() -> list[tuple[str, str]]:
+    """族内 skill 的 SKILL.md 与 references/，排除历史与测试目录。"""
+    out: list[tuple[str, str]] = []
+    for skill in TASK_SKILLS:
+        for path in sorted((SKILLS_ROOT / skill).rglob("*.md")):
+            if any(p in SKIP_DIRS for p in path.relative_to(SKILLS_ROOT / skill).parts):
+                continue
+            out.append((str(path.relative_to(SKILLS_ROOT.parent)), path.read_text(encoding="utf-8")))
+    return out
+
+
+class TestPayloadOwners(unittest.TestCase):
+    """完成判据归 task-wizard；质量画像与显式降级归 task-goal 复杂档。"""
+
+    def test_wizard_provides_completion_criterion(self) -> None:
+        self.assertIn("## 完成判据", read("task-wizard", "SKILL.md"))
+
+    def test_wizard_does_not_provide_quality_profile(self) -> None:
+        self.assertNotIn("质量画像", read("task-wizard", "SKILL.md"))
+
+    def test_goal_declares_profile_ownership(self) -> None:
+        self.assertIn("质量画像与显式降级由本协议产出", read("task-goal", "SKILL.md"))
+
+    def test_no_stale_wizard_profile_attribution(self) -> None:
+        stale = ("由 task-wizard 复杂档产出", "上游 task-wizard 复杂档")
+        for path, text in live_texts():
+            for s in stale:
+                self.assertNotIn(s, text, f"{path} 仍把质量画像归给 task-wizard")
+
+
+class TestFailureCountingSingleSource(unittest.TestCase):
+    """失败计数的数字口径只在 task-goal 定义，消费者不复述。"""
+
+    def test_goal_defines_thresholds(self) -> None:
+        goal = read("task-goal", "SKILL.md")
+        self.assertIn("同一假设", goal)
+        self.assertIn("累计假设已达 3 个", goal)
+
+    def test_consumers_do_not_restate_thresholds(self) -> None:
+        delivery = read("task-delivery", "SKILL.md") + read("task-delivery", "references/loop-protocol.md")
+        self.assertNotIn("假设累计封顶 3", delivery)
+        self.assertNotIn("累计假设已达 3 个", delivery)
+
+    def test_consumers_point_to_source(self) -> None:
+        self.assertIn("task-goal", read("task-delivery", "SKILL.md"))
+
+
+class TestFamilyLinksResolve(unittest.TestCase):
+    """族内 markdown 相对链接必须可达（含跨 skill 引用）。"""
+
+    def test_all_relative_links_reachable(self) -> None:
+        broken: list[str] = []
+        for skill in TASK_SKILLS:
+            for path in sorted((SKILLS_ROOT / skill).rglob("*.md")):
+                if any(p in SKIP_DIRS for p in path.relative_to(SKILLS_ROOT / skill).parts):
+                    continue
+                text = path.read_text(encoding="utf-8")
+                for m in re.finditer(r"\]\(([^)#\s]+\.md)(?:#[^)]*)?\)", text):
+                    target = m.group(1)
+                    if target.startswith(("http://", "https://")):
+                        continue
+                    if not (path.parent / target).resolve().is_file():
+                        broken.append(f"{path.relative_to(SKILLS_ROOT.parent)} -> {target}")
+        self.assertEqual(broken, [], "存在不可达的相对链接")
+
+
+class TestFamilyComplete(unittest.TestCase):
+    """五个 task* skill 需同装：跨 skill 引用按仓内相对路径解析。"""
+
+    def test_all_task_skills_present(self) -> None:
+        missing = [s for s in TASK_SKILLS if not (SKILLS_ROOT / s / "SKILL.md").is_file()]
+        self.assertEqual(missing, [], "族内 skill 缺项会导致跨 skill 引用断链")
+
+
+if __name__ == "__main__":
+    unittest.main()
